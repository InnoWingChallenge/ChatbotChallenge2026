# Chatbot Challenge 2026
#
#     cp .env.example .env
#
# Optional. The notebooks fall back to these same values if there is no
# .env, so they run either way. Use .env to override a deployment or
# point at a different gateway without editing six notebooks.
#
# Keep .env in .gitignore. A committed key gets rotated, and a rotated
# key means your submission stops working.

# If set, the notebooks use this instead of prompting for the key.
AZURE_OPENAI_KEY=XXXXXX

AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Gateway bases, no trailing slash. The code appends the deployment and
# operation to these.
AZURE_CHAT_BASE=https://api-iw.azure-api.net/sig-shared-jpeast
AZURE_EMBED_BASE=https://api-iw.azure-api.net/sig-embedding

# Azure addresses a deployment, not a model. Chat and vision are
# different deployments here.
CHAT_DEPLOYMENT=gpt-4o-mini
VISION_DEPLOYMENT=gpt-5-mini
EMBED_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------
# For reference, the URLs the code builds from the above. You do not set
# these; they are here so you can paste one into curl when debugging.
#
#   chat    {CHAT_BASE}/deployments/{CHAT_DEPLOYMENT}/chat/completions?api-version={V}
#   vision  {CHAT_BASE}/deployments/{VISION_DEPLOYMENT}/chat/completions?api-version={V}
#   embed   {EMBED_BASE}/openai/deployments/{EMBED_DEPLOYMENT}/embeddings?api-version={V}
#
# The chat route has no /openai segment and the embedding route does.
# That asymmetry is real. Making them match will 404 one of them.
# ---------------------------------------------------------------------
